<div id="toast-notificacion"></div>
<div class="d-flex flex-column my-2 px-5">
  <div class="col-lg-12 mb-2">
    <div class="card shadow bg-body-tertiary border-0">
      <div class="card-body d-flex flex-row justify-content-start align-items-center gap-3" style="color: #0d2033;">
        <i class="fas fa-chalkboard-teacher fs-6 text-nowrap m-0" style="width: 1rem;"></i>
        <p class="fs-6 text-nowrap m-0" style="width: 1rem;">Profesores > Asignar materias</p>
      </div>
    </div>
  </div>
  <div class="col-lg-12 mb-2">
    <div class="row g-5">
      <div class="col-md-12">
        <div class="card shadow bg-body-tertiary border-0" id="card-asignarMateria">
          <div class="card-header color-background">
            <h4 class="text-white text-center fw-semibold m-0" id="txt-accion">Asignar materias:</h4>
          </div>
          <div class="card-body">
            <div class="col g-4">
              <div class="col-md-12">
                <p class="card-title fs-4 text-start border-bottom border-secondary" style="color: #0d2033;">Profesores
                  disponibles:
                </p>
                <div class="d-flex flex-column mb-3 justify-content-center" id="form-grupoGuia">
                  <div class="row align-items-center">
                    <div class="col-md-5 position-relative py-2" id="btn-profesor">
                      <label for="inputState" class="form-label">Profesores:</label>
                      <select class="form-select border-secondary" name="profesor" id="profesor" required>
                        <option selected disabled value="">Elegir...</option>
                      </select>
                      <div class="invalid-tooltip">
                        ¡Falta Seleccionar!
                      </div>
                    </div>
                    <div class="col-md-5 position-relative py-2" id="btn-materia">
                      <label for="inputState" class="form-label">Materias:</label>
                      <select class="form-select border-secondary" name="materia" id="materia" required>
                        <option  selected disabled value="">Elegir...</option>
                      </select>
                      <div class="invalid-tooltip">
                        ¡Falta Seleccionar!
                      </div>
                    </div>
                    <div class="col-md-2 text-center py-2">
                      <button class="btn btn-success" id="btn-asignarMaterias">Asignar</button>
                    </div>
                  </div>
                </div>
              </div><!--Card para ingresar grupo guia-->
              <div class="col-md-12">
                <p class="card-title fs-4 text-start border-bottom border-secondary" style="color: #0d2033;">Materias asignadas:
                </p>
                <div class="table-responsive">
                  <table class="table table-striped table-bordered nowrap" id="dt-profeMateria" style="width: 100%;">
                    <thead class="table-secondary">
                      <tr>
                        <th class="text-center">Id</th>
                        <th>Profesor</th>
                        <th class="text-center">Materia</th>
                        <th class="text-center">Acciones</th>
                      </tr>
                    </thead>
                    <tbody></tbody>
                  </table>
                </div>
              </div><!--Card para visualizar grupo guia -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-12 mb-2">
    <div class="card shadow bg-body-tertiary rounded" id="card-Materia">
      <div class="card-header color-background">
        <h3 class="text-white text-center fw-semibold m-0" id="txt-accion">Materias:</h3>
      </div>
      <div class="card-body">
        <div class="col g-5">
          <div class="col-md-12">
            <p class="card-title fs-4 text-start border-bottom border-secondary" style="color: #0d2033;">Agregar
              materias:
            </p>
            <div class="col-md-6 mb-3">
              <div class="d-flex flex-row" id="form-materia">
                <div class="position-relative">
                  <label for="inputText" class="form-label text-start fs-5 my-2 mx-1">Materia:</label>
                  <input name="nombre_materia" type="text" class="form-control border border-secondary p-2" id="nombre-materia" placeholder="lengua y literatura" required>
                  <div class="invalid-tooltip">
                    ¡Esta vacío!
                  </div>
                </div>
                <div class="d-flex align-items-end mx-2">
                  <button class="btn btn-success" id="btn-agregarMateria">Agregar</button>
                </div>
              </div>
            </div>
            <div class="col-md-12">
              <label for="inputText" class="form-label text-start fs-5 my-2 mx-1">Materias recientes:</label>
              <div class="table-responsive">
                <table class="table table-striped table-bordered nowrap" id="dt-materia" style="width: 100%;">
                  <thead class="table-secondary">
                    <tr>
                      <th class="text-center">Id</th>
                      <th>Materia</th>
                      <th class="text-center">Fecha</th>
                      <th class="text-center">Acciones</th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div><!--visualizar el registro de materias-->
            </div>
          </div><!--Card para crear materias-->
        </div>
      </div>
    </div>
  </div>
</div>
<!-- modal-message -->
<div id="crearModal"></div>
<!-- modal-message -->
<script src="https://cdn.datatables.net/v/bs5/jq-3.7.0/dt-2.0.8/r-3.0.2/sl-2.0.3/datatables.min.js"></script>
<script src="/event/administrador/materiasProfe.js"></script>