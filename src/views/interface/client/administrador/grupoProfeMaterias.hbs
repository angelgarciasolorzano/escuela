              </div>
              <div class="col-md-3" id="btn-profesorMateria">
                <label for="inputState" class="form-label">Materias del profesor guia:</label>
                <select class="form-select border-secondary" name="profesor" id="profesorMateria">
                </select>
              </div>
            </div>
          </div><!--Card para ingresar grupo guia-->
