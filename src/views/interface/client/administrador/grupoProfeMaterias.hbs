            <p class="card-title fs-3 text-start border-bottom border-secondary" style="color: #0d2033;">Grado/nivel:
            </p>
            <div class="table-responsive">
              <table class="table table-striped table-bordered nowrap" id="dt-grupoProfeMate" style="width: 100%;">
                <thead class="table-secondary">
                  <tr>
                    <th>Id</th>
                    <th>Grupo</th>
                    <th class="text-center">Materia</th>
                    <th class="text-center">Profesor</th>
                    <th class="text-center">Acciones</th>
                  </tr>
                </thead>
                <tbody></tbody>
              </table>
            </div>
          </div><!--Card para visualizar grupo guia -->
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-12 mb-2">
