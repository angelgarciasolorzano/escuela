                    ¡Falta Seleccionar!
                  </div>
                </div>
                <div class="col-md-2">
                  <div class="d-flex justify-content-center align-items-center py-2">
                    <button class="btn btn-success" id="btn-asignarGrupo">Asignar</button>
                  </div>
                </div>
              </div>
            </div>
          </div><!--Card para ingresar grupo guia-->
          <div class="col-md-12">
            <p class="card-title fs-3 text-start border-bottom border-secondary" style="color: #0d2033;">Historial
              reciente:</p>
            <div class="table-responsive">
              <table class="table table-striped table-bordered nowrap" id="dt-grupoGuia" style="width: 100%;">
                <thead class="table-secondary">
                  <tr>
                    <th class="text-center">Id</th>
                    <th class="text-center">Grupo</th>
                    <th class="text-center">Profesor</th>
                    <th class="text-center">Acciones</th>
                  </tr>
                </thead>
                <tbody></tbody>
              </table>
            </div>
          </div><!--Card para visualizar grupo guia -->
        </div>
      </div>
    </div>
  </div>
</div>
