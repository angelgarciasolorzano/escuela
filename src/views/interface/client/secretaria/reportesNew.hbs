<div id="toast-notificacion"></div>
<div class="d-flex flex-column py-2 px-5">
  <div class="col-lg-12 mb-2">
    <div class="card shadow bg-body-tertiary border-0">
      <div class="card-body d-flex flex-row justify-content-start align-items-center gap-2" style="color: #0d2033;">
        <i class="fa-solid fa-chart-column fs-6 text-nowrap m-0" style="width: 1rem;"></i>
        <p class="fs-6 text-nowrap m-0" style="width: 1rem; color: #0d2033;">Reportes</p>
      </div>
    </div>
  </div>
  <div class="col-lg-12 mb-2">
    <div class="col g-4">
      <div class="card shadow bg-body-tertiary border-0">
        <div class="card-header color-background">
          <h4 class="text-white text-center fw-semibold m-0">Sistema de reportes</h4>
        </div>
        <div class="card-body">
          <div class="col g-3">
            <p class="card-title fs-4 text-start border-bottom border-secondary" style="color: #0d2033;">
              Panel de
              configuración:
            </p>
            <div class="col position-relative" id="form-config"> <!--panel de configuración-->
              <div class="row g-2"> <!--columna-filtro-->
                <div class="col-md-3 g-2">
                  <label for="inputState" class="col-form-label">Filtro:</label>
                  <select class="form-select border-secondary" id="filtro_reporte">
                    <option selected disabled value="">Elegir...</option>
                    <option class="filtro-item" value="sexo">género</option>
                    <option class="filtro-item" value="modalidad">modalidad</option>
                  </select>
                </div>
                <div class="col-md-2 g-2 mx-3">
                  <label for="inputState" class="col-form-label">Búsqueda por año:</label>
                  <div class="row">
                    <div class="d-flex justify-content-center align-items-center my-2">
                      <div class="col">
                        <div class="form-check form-check-inline">
                          <input class="form-check-input" type="radio" name="inlineRadioOptions" id="optionEspecifico"
                            value="option1">
                          <label class="form-check-label" for="inlineRadio1">Específico</label>
                        </div>
                      </div>
                      <div class="col">
                        <div class="form-check form-check-inline ">
                          <input class="form-check-input" type="radio" name="inlineRadioOptions" id="optionRango"
                            value="option2">
                          <label class="form-check-label" for="inlineRadio2">Rango</label>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col g-2" id="formAniolectivo">
                  <div class="col-md-4 g-2 d-none" id="formEspecificoAnio">
                    <label for="inputState" class="col-form-label">Año lectivo:</label>
                    <select class="form-select border-secondary" name="aniolectivo" id="aniolectivo">
                      <option selected disabled value="">Elegir...</option>
                      {{#if aniolectivo}}
                      {{#each aniolectivo}}
                      <option class="aniolectivo-item" value={{this.anio}}>{{this.anio}}</option>
                      {{/each}}
                      {{/if}}
                    </select>
                  </div>
                  <div class="row g-2 d-none" id="formRangoAnio">
                    <div class="col-md-4 g-2">
                      <label for="inputState" class="col-form-label">Año lectivo inicial:</label>
                      <select class="form-select border-secondary" name="aniolectivoRango" id="aniolectivo_inicial">
                        <option selected disabled value="">Elegir...</option>
                        {{#if aniolectivo}}
                        {{#each aniolectivo}}
                        <option class="aniolectivo-item" value={{this.anio}}>{{this.anio}}</option>
                        {{/each}}
                        {{/if}}
                      </select>
                    </div>
                    <div class="col-md-4 g-2">
                      <label for="inputState" class="col-form-label">Año lectivo final:</label>
                      <select class="form-select border-secondary" name="aniolectivoRango" id="aniolectivo_final">
                        <option selected disabled value="">Elegir...</option>
                        {{#if aniolectivo}}
                        {{#each aniolectivo}}
                        <option class="aniolectivo-item" value={{this.anio}}>{{this.anio}}</option>
                        {{/each}}
                        {{/if}}
                      </select>
                    </div>
                  </div>
                </div><!--columna-añoslectivos-->
              </div>

            </div>
            <div class="col">
              <div class="text-center pt-3">
                <button class="btn btn-danger d-none" type="button" id="btn-loading" disabled>
                  <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                  <span role="status">Loading...</span>
                </button>
                <button class="btn btn-danger btn-block" id="btn-generar-reporte">
                  Generar
                  <i class="fa-regular fa-file-pdf px-2"></i></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- modal-message -->
  <div id="crearModal"></div>
  <!-- modal-message -->
  <script src="https://cdn.datatables.net/v/bs5/jq-3.7.0/dt-2.0.8/r-3.0.2/sl-2.0.3/datatables.min.js"></script>
  <script src="/event/secretaria/reportesNew.js"></script>