<script src="https://cdn.datatables.net/v/bs5/jq-3.7.0/dt-2.0.8/r-3.0.2/sl-2.0.3/datatables.min.js"></script>
<script>
  $(document).ready(function () {
    // Inicializa DataTables
    var table = $('#dt-calificacion').DataTable();

    // Variable para guardar temporalmente el input activo y evitar múltiples ediciones
    var activeInput = null;

    // Delega el evento click a las celdas del tbody
    $('#dt-calificacion tbody').on('click', 'td', function () {
      // Si ya estamos editando esta celda o hay otro input activo, no hacemos nada
      // excepto si hacemos clic FUERA del input activo (manejado por el 'blur' abajo)
      if (activeInput && activeInput.td.is(this)) {
        return;
      }

      // Si había otro input activo, lo guardamos primero
      if (activeInput) {
        saveCellData(activeInput.td, activeInput.input, activeInput.cellApi);
      }

      var cellApi = table.cell(this); // Obtiene la API de la celda específica
      var originalData = cellApi.data(); // Obtiene el dato actual
      var $td = $(this); // El elemento <td> como objeto jQuery

      // Crea el input
      var $input = $('<input type="text" class="edit-input">')
        .val(originalData);

      // Reemplaza el contenido de la celda con el input
      $td.html($input);

      // Guarda la referencia al input activo
      activeInput = {
        td: $td,
        input: $input,
        cellApi: cellApi,
        originalData: originalData // Guardamos el original por si se cancela
      };

      // Enfoca el input
      $input.focus();

      // --- Manejadores de eventos para el input ---

      // 1. Al perder el foco (blur) - Guardar
      $input.on('blur', function () {
        // Se usa un pequeño timeout para permitir que el clic en otra celda
        // se procese antes de que este blur cierre el input.
        setTimeout(function () {
          // Solo guardar si el input todavía existe (no fue reemplazado por otro clic)
          if (activeInput && activeInput.input.is($input)) {
            saveCellData($td, $input, cellApi);
          }
        }, 100); // 100ms suele ser suficiente
      });

      // 2. Al presionar una tecla (keydown) - Guardar con Enter, Cancelar con Escape
      $input.on('keydown', function (e) {
        if (e.key === "Enter") { // Si es Enter
          e.preventDefault(); // Evita cualquier comportamiento por defecto (ej. submit si está en un form)
          saveCellData($td, $(this), cellApi);
        } else if (e.key === "Escape") { // Si es Escape
          cancelEdit($td, cellApi, originalData);
        }
      });
    });

    // --- Funciones auxiliares ---

    function saveCellData($tdElement, $inputElement, cellInstance) {
      var newData = $inputElement.val();
      // Actualiza el dato en DataTables y redibuja la celda SIN resetear paginación
      cellInstance.data(newData).draw(false);
      activeInput = null; // Ya no hay input activo
      // Nota: .draw() ya reemplaza el input por el nuevo texto.
      // Si no usaras .draw(), necesitarías: $tdElement.text(newData);
    }

    function cancelEdit($tdElement, cellInstance, originalValue) {
      // Simplemente restaura el HTML original visualmente
      // No es estrictamente necesario actualizar cellInstance.data() si no cambió,
      // pero podrías hacerlo para mayor seguridad si draw() se llamara después.
      $tdElement.html(originalValue);
      activeInput = null; // Ya no hay input activo
    }

    // Opcional: Evitar que la ordenación se active con un solo clic en el encabezado
    // Si quieres que la ordenación necesite doble clic o solo funcione con el icono:
    /*
    $('#miTabla thead').on('click', 'th', function(e) {
        // Previene la acción de ordenación por defecto si el clic fue rápido
        // Puedes ajustar la lógica según necesites
    });
    */

  });
</script>