<nav class="navbar navbar-expand-lg navbar-dark color-background">
  <div class="container-fluid">
    <img src="/img/logo_colegio.png" class="img-fluid pe-3" alt="" width="50" height="50">
    <a class="navbar-brand">Colegio Cristiano Fuente de Vida</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav" style="margin-left: auto">
        <li class="nav-item">
          <a class="nav-link text-white text-end " href="/">Inicio</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<div class=" mx-auto my-auto py-5" style="width: 90%;">
  <div class="row">
    <div class="col-md-4 mx-auto">
      <div class="card text-center border-0 shadow">
        <div class="card-header border-secondary color-background text-white">
          <h3>Iniciar Sesión</h3>
        </div>
        <div class="card-body">
          <img src="/img/logo.jfif" alt="logo Fazt" class="card-img-top mx-auto m-2 rounded-circle w-50">
          <form form action="/login" method="post">
            {{#if messages}}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <div class="d-flex flex-row gap-2">
                <i class="bi bi-exclamation-circle-fill fs-6 text-nowrap m-0" style="width: 1rem;"></i>
                <p class="fs-6 text-nowrap m-0" style="width: 1rem;">{{messages}}</p>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            </div>
            {{/if}}
            <div class="input-group flex-nowrap mb-3">
              <span class="input-group-text bg-black text-white border-secondary" id="addon-wrapping"><i
                  class="bi bi-person-fill"></i></span>
              <input id="login-usuario" name="usuario" type="email" class="form-control border-secondary"
                placeholder="Email" aria-label="Usuario" aria-describedby="addon-wrapping" required>
            </div>
            <div class="input-group flex-nowrap mb-3">
              <span class="input-group-text bg-black text-white border-secondary" id="addon-wrapping"><i
                  class="bi bi-lock-fill"></i></span>
              <input id="login-pass" name="contrasena" type="password" class="form-control border-secondary"
                placeholder="Contraseña" aria-label="Contraseña" aria-describedby="addon-wrapping" required>
            </div>
            <div class="text-center">
              <button class="btn btn-success btn-block" id="btn-login">Acceder</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>