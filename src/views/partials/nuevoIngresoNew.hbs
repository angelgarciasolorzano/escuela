<link rel="stylesheet" href="/css/addestudiante.css">
<div class="container p-2 border-secondary contenedor-alerta">
  <div class="card border-secundary">
    <div class="card-body">
      <form class="form">
        <!-- Steps-Icons -->
        <div class="container_icon">
          <i class="fa-solid fa-restroom"></i>
          <i class="fa-solid fa-children"></i>
          <i class="fa-regular fa-id-card"></i>
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <!-- Progress bar -->
        <div class="progressbar">
          <div class="progress" id="progress"></div>
          <div class="progress-step progress-step-active" data-title="Tutor"></div>
          <div class="progress-step" data-title="Estudiante"></div>
          <div class="progress-step" data-title="Matricula"></div>
          <div class="progress-step" data-title="Resultado"></div>
        </div>
        <!-- Step-Tutor -->
        <div class="form-step form-step-active">
          <div class="container pt-0">
            <div class="container text-center">
              <div class="row">
                <div class="col-md-6">
                  <div class="d-flex flex-row justify-content-center align-items-center">
                    <div class="form-check p-2 text-center">
                      <input class="form-check-input" type="checkbox" value="" id="checkTutor">
                      <label class="form-check-label" for="checkTutor">
                        ¿Necesita buscar el tutor?
                      </label>
                    </div>
                    <div class="p-2">
                      <button type="button" class="btn btn-primary w-100" data-bs-toggle="modal" id="btn-buscarTutor"
                        data-bs-target="#tutorModal" disabled>Buscar
                        Tutor</button>
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="d-flex flex-row justify-content-center align-items-center">
                    <div class="p-2">
                      <label for="inputText" class="col-form-label">Secretari@:</label>
                    </div>
                    <div class="p-1">
                      <input type="text" id="correo_usuario" class="form-control" aria-describedby="textHelpInline"
                        value={{user.correo_e}} disabled>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <!--Datos del Tutor-->
            <div class="col-md-12 pt-3">
              <div class="card-body">
                <fieldset class="border border-primary rounded-3 p-2">
                  <legend class="float-none w-auto px-2">Datos personales tutor</legend>
                  <div class="row g-3" id="form-tutor">
                    <div class="col-lg-3 position-relative">
                      <label for="inputText" class="form-label">Nombres y Apellidos:</label>
                      <input name="nombres_tutor" type="text" class="form-control border border-secondary"
                        id="nombres-tutor" placeholder="Juan Pablo Garcia Solorzano" required>
                      <div class="invalid-tooltip">
                        Error!
                      </div>
                    </div>
                    <div class="col-lg-3 position-relative">
                      <label for="inputText" class="form-label">Cédula:</label>
                      <input name="cedula_tutor" type="text" class="form-control border-secondary" id="cedula-tutor"
                        placeholder="000-011280-0000B" required>
                      <div class="invalid-tooltip">
                        Error!
                      </div>
                    </div>
                    <div class="col-lg-3 position-relative">
                      <label for="inputNumber" class="form-label">Teléfono:</label>
                      <input name="telefono_tutor" type="text" class="form-control border-secondary" id="telefono-tutor"
                        placeholder="84125477" required>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-3 position-relative">
                      <label for="inputAddress" class="form-label">Correo-e (opcional):</label>
                      <input name="correo_e_tutor" type="text" class="form-control border-secondary" id="correo-tutor"
                        placeholder="juan_pablo12@gmail.com" required>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-3 position-relative">
                      <label for="inputState" class="form-label">Relación con el
                        Estudiante:</label>
                      <select name="relacion_tutor" id="relacion-tutor" class="form-select border border-secondary"
                        disabled>
                        <option selected disabled value="">Elegir...</option>
                        <option value="Madre">Madre</option>
                        <option value="Padre">Padre</option>
                        <option value="Otro Familiar">Otro Familiar</option>
                        <option value="Ninguna">Ninguna</option>
                      </select>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-8 position-relative">
                      <label for="inputText" class="form-label">Ocupación:</label>
                      <input name="ocupacion_tutor" type="text" class="form-control border-secondary"
                        id="ocupacion-tutor" placeholder="Ejecutiv@ de ventas" required>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-12 position-relative">
                      <label for="inputText" class="form-label">Dirección del trabajo:</label>
                      <input name="direccion_tutor" type="text" class="form-control border-secondary"
                        id="direccion-tutor" placeholder="municipio, distrito-barrio, casa#" required>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                  </div>
                </fieldset>
              </div>
            </div>
          </div>
          <div class="container pt-4">
            <a href="#" class="btn btn-next width-50 ml-auto" id="btn_documento">Siguiente</a>
          </div>
        </div>
        <!-- Step-Estudiante -->
        <div class="form-step">
          <!--Datos del Estudiante-->
          <div class="col-md-12 pt-0">
            <div class="card-body">
              <div class="row g-3 p-2">
                <fieldset class="border border-primary rounded-3 p-2">
                  <legend class="float-none w-auto px-2">Datos personales estudiante</legend>
                  <div class="row g-3" id="form-estudiante">
                    <div class="col-lg-4 position-relative">
                      <label for="inputText" class="form-label">Nombres:</label>
                      <input name="nombres_est" type="text" class="form-control border-secondary" id="nombres-est"
                        placeholder="Jennifer Sofia">
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputText" class="form-label">Apellidos:</label>
                      <input name="apellidos_est" type="text" class="form-control border-secondary" id="apellidos-est"
                        placeholder="Fernandez Ortiz">
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputText" class="form-label">Código Estudiantil:</label>
                      <input name="codigo_est" type="text" class="form-control border-secondary" id="codigo-est"
                        placeholder="JSFO-030109-0000000">
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputText" class="form-label">Cédula (opcional):</label>
                      <input name="cedula_est" type="text" class="form-control border-secondary" id="cedula-est"
                        placeholder="000-011280-0000B">
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputText" class="form-label">#Registro Nacimiento (opcional):</label>
                      <input name="registroNac_est" type="text" class="form-control border-secondary"
                        id="registroNac-est" placeholder="#Tomo-#Folio-#Partida">
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputDate" class="form-label">Fecha de Nacimiento:</label>
                      <input name="fechaNac_est" type="date" class="form-control border-secondary" id="fecha-est">
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputState" class="form-label">Género:</label>
                      <select class="form-select border-secondary" name="sexo_est" id="sexo-est">
                        <option selected disabled value="">Elegir...</option>
                        <option value="M">Masculino</option>
                        <option value="F">Femenino</option>
                      </select>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputState" class="form-label">Pueblo indígena, Afrodescendiente ó
                        etnia:</label>
                      <select class="form-select border-secondary" name="etnia_est" id="etnia-est">
                        <option selected disabled value="">Elegir...</option>
                        <option value="Miskitu">Miskitu</option>
                        <option value="Mayangna">Mayangna</option>
                        <option value="Rama">Rama</option>
                        <option value="Ulwa">Ulwa</option>
                        <option value="Creole">Creole</option>
                        <option value="Garifuna">Garifuna</option>
                        <option value="Mestizo Costa Caribe">Mestizo Costa Caribe</option>
                        <option value="Matagalpa">Matagalpa</option>
                        <option value="Chorotega">Chorotega</option>
                        <option value="Nahoa-Niquiranos">Nahoa-Niquiranos</option>
                        <option value="Xiu-Sutiaba">Xiu-Sutiaba</option>
                        <option value="Mestizo Pacifico-Central-Norte">Mestizo Pacífico-Central-Norte
                        </option>
                      </select>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputState" class="form-label">Lengua Materna:</label>
                      <select class="form-select border-secondary" name="lengua_est" id="lengua-est">
                        <option selected disabled value="">Elegir...</option>
                        <option value="Español">Español</option>
                        <option value="Miskitu">Miskitu</option>
                        <option value="Mayangna Tuakha">Mayangna Tuakha</option>
                        <option value="Mayangna Panamanka">Mayangna Panamanka</option>
                        <option value="Mayangna Yusku">Mayangna Yusku</option>
                        <option value="Ulwa">Ulwa</option>
                        <option value="Creole">Creole</option>
                        <option value="Ingles">Ingles</option>
                        <option value="Garifuna">Garifuna</option>
                        <option value="Rama">Rama</option>
                      </select>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputState" class="form-label">Discapacidad (según diagnóstico
                        médico):</label>
                      <select class="form-select border-secondary" name="discapacidad_est" id="discapacidad-est">
                        <option selected disabled value="">Elegir...</option>
                        <option value="Intelectual">Intelectual</option>
                        <option value="Autismo">Autismo</option>
                        <option value="Hipoacusia">Hipoacusia</option>
                        <option value="Baja vision">Baja vision</option>
                        <option value="Multidiscapacidad">Multidiscapacidad</option>
                        <option value="Fisico Motora">Fisico Motora</option>
                        <option value="Sordo">Sordo</option>
                        <option value="Ciego">Ciego</option>
                        <option value="Sordo-Ciego">Sordo-Ciego</option>
                        <option value="Ninguna">Ninguna</option>
                      </select>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputText" class="form-label">Teléfono (opcional):</label>
                      <input name="telefono_est" type="text" class="form-control border-secondary" id="telefono-est"
                        placeholder="84125477">
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputText" class="form-label">Lugar de Nacimiento (País):</label>
                      <input name="lugarNac_est" type="text" class="form-control border-secondary" id="lugarNac-est"
                        placeholder="Nicaragua">
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputText" class="form-label">Nacionalidad:</label>
                      <input name="nacionalidad_est" type="text" class="form-control border-secondary"
                        id="nacionalidad-est" placeholder="Nicaragüense">
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-8 position-relative">
                      <label for="inputText" class="form-label">Dirección Domiciliar:</label>
                      <input name="direccionDom_est" type="text" class="form-control border-secondary"
                        id="direccionDom-est" placeholder="municipio, distrito-barrio, casa#">
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>

                  </div>
                </fieldset>
              </div>

            </div>
          </div>
          <div class="btns-group pt-4">
            <a href="#" class="btn btn-prev">Atras</a>
            <a href="#" class="btn btn-next" id="btn_tutor">Siguiente</a>
          </div>
        </div>
        <!-- Step-Matricula -->
        <div class="form-step">
          <!--Datos del Matricula-->
          <div class="col-md-12 pt-0">
            <div class="card-body">
              <div class="row g-3 p-2">
                <fieldset class="border border-primary rounded-3 p-2">
                  <legend class="float-none w-auto px-2">Datos matrícula</legend>
                  <div class="row g-3" id="form-matriculaNuevo">
                    <div class="col-lg-4 position-relative">
                      <label for="inputState" class="form-label">Repitente:</label>
                      <select class="form-select border-secondary" name="repitente_est" id="repitente-est">
                        <option selected disabled value="">Elegir...</option>
                        <option value="Si">Sí</option>
                        <option value="No">No</option>
                      </select>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputState" class="form-label">Trasladado:</label>
                      <select class="form-select border-secondary" name="trasladado_est" id="trasladado-est">
                        <option selected disabled value="">Elegir...</option>
                        <option value="Si">Sí</option>
                        <option value="No">No</option>
                      </select>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputState" class="form-label">Modalidad:</label>
                      <select class="form-select border-secondary" name="modalidad_est" id="modalidad-est">
                        <option selected disabled value="">Elegir...</option>
                        {{#if modalidad}}
                        {{#each modalidad}}
                        <option value={{this.id_modalidad}}>{{this.nombre}}</option>
                        {{/each}}
                        {{/if}}
                      </select>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputState" class="form-label">Nivel/Grado Actual:</label>
                      <select class="form-select border-secondary" name="nivel_est" id="nivel-est" disabled>
                        <option selected disabled value="">Elegir...</option>
                      </select>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputState" class="form-label">Grupos Disponibles:</label>
                      <select class="form-select border-secondary" name="grupo_nuevoIngreso" id="grupo-nuevoIngreso"
                        disabled>
                        <option selected disabled value="">Elegir...</option>
                      </select>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                    <div class="col-lg-4 position-relative">
                      <label for="inputText" class="form-label">Turno:</label>
                      <input name="turno_nuevoIngreso" type="text" class="form-control border-secondary" value=""
                        id="turno-nuevoIngreso" placeholder="" disabled>
                      <div class="invalid-tooltip">
                        ¡Error!
                      </div>
                    </div>
                  </div>
                  <!--Papeleo a Entregar-->
                  <div class="container text-center pt-5 ps-3 text-black">
                    <div class="form-check text-black form-check-inline">
                      <input class="form-check-input" type="checkbox" id="inlineCheckbox1"
                        value="Partida de Nacimiento">
                      <label class="form-check-label" for="inlineCheckbox1">Fotocopia Partida de
                        Nacimiento</label>
                      <div class="invalid-feedback ms-3">
                        Documento Obligatorio!
                      </div>
                    </div>
                    <div class="form-check form-check-inline">
                      <input class="form-check-input" type="checkbox" id="inlineCheckbox2"
                        value="Copia de cedula del Tutor">
                      <label class="form-check-label" for="inlineCheckbox2">Fotocopia de Cedula del Tutor</label>
                      <div class="invalid-feedback ms-3">
                        Documento Obligatorio!
                      </div>
                    </div>
                    <div class="form-check form-check-inline">
                      <input class="form-check-input" type="checkbox" id="inlineCheckbox3" value="Copia del boletin">
                      <label class="form-check-label" for="inlineCheckbox3">Fotocopia del Boletin ó Certificado de
                        notas</label>
                      <div class="invalid-feedback ms-3">
                        Documento Obligatorio!
                      </div>
                    </div>
                    <div class="form-check form-check-inline d-none position-relative" id="hojasTrasladoNuevo">
                      <input class="form-check-input" type="checkbox" id="checkTrasladadoNuevo-est" value="">
                      <label class="form-check-label" for="checkTrasladadoNuevo">2 hojas de traslado</label>
                      <div class="invalid-tooltip">
                        Documento Obligatorio!
                      </div>
                    </div>
                  </div>
                </fieldset>
              </div>

            </div>
          </div>
          <div class="btns-group pt-4">
            <a href="#" class="btn btn-prev">Atras</a>
            <input type="submit" value="Ingresar Datos" class="btn" id="btn_registrar" />
          </div>
        </div>
        <!-- Step-Completado -->
        <div class="form-step">
          <div class="container d-flex flex-column justify-content-center text-center text-black m-30">
            <h2 class="pt-2">Los datos se ingresaron correctamente!!</h2>
            <a href="#" type="button" class="btn btn-block pt-4" id="btn-recargar">Regresar</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
<script src="/event/secretaria/addestudiante.js"></script>