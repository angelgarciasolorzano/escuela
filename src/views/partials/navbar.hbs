<script>
  $("#cerrarSesion").on("click", function (e) {
    e.preventDefault();
    const modal = document.querySelector('modal-message');
    modal.show();
    // Acceder al botón dentro del Shadow DOM
    const aceptarBtn = modal.shadowRoot.querySelector('#btn-aceptar-modalMessage');
    aceptarBtn.addEventListener('click', function () {
      cerrarSession();
      localStorage.clear();
    });
  });

  async function cerrarSession() {
    try {
      const response = await axios.get('/cerrar');
      location.reload();
    } catch (error) { console.log('Error', error.message); }
  };
</script>